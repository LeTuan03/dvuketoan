generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique
  title       String
  titleEn     String?
  category    String
  publishDate String
  thumbnail   String   @default("")
  excerpt     String   @default("")
  excerptEn   String?
  content     String   @default("")
  contentEn   String?
  featured    Boolean  @default(false)
  isDraft     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("articles")
}

model Banner {
  id      BigInt  @id @default(autoincrement())
  image   String  @default("")
  title   String
  titleEn String?
  link    String  @default("")
  status  Boolean @default(true)
  order   Int     @default(0)

  @@map("banners")
}

model NavMenu {
  id       BigInt  @id @default(autoincrement())
  name     String
  nameEn   String?
  link     String
  parent   BigInt?
  position String  @default("header")
  order    Int     @default(0)
  status   Boolean @default(true)
  hasMega  Boolean @default(false)
  isButton Boolean @default(false)

  @@map("nav_menus")
}

model Setting {
  id   BigInt @id @default(1)
  data Json   @default("{}")

  @@map("settings")
}

model ContactRequest {
  id           BigInt   @id @default(autoincrement())
  fullName     String
  phoneNumber  String
  emailAddress String?
  messageBox   String
  locale       String   @default("vi")
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([status])
  @@map("contact_requests")
}

model LookupItem {
  id            BigInt   @id @default(autoincrement())
  code          String   @unique
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  isConditional Boolean  @default(false)
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("lookup_items")
}

model MediaGallery {
  id        BigInt   @id @default(autoincrement())
  title     String
  url       String
  thumbnail String?
  mediaType String
  status    String   @default("active")
  order     Int      @default(0)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media_gallery")
}

